{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "mosaic.research.saturation-assessment.v0.1", "type": "object", "additionalProperties": false,
  "required": ["schema", "assessment_id", "subject_root", "lens_pack_root", "pass_roots", "assessment_window", "new_substantive_findings_by_pass", "accepted_substantive_changes_by_pass", "severity_weighted_yield_by_pass", "repeated_finding_count_by_pass", "regression_count_by_pass", "coverage_delta_basis_points", "unresolved_high_severity_roots", "thresholds", "result", "stop_reason", "nonclaims", "standing", "authority_effect", "real_a5", "g0", "saturation_assessment_root"],
  "properties": {"schema": {"const": "mosaic.research.saturation-assessment.v0.1"}, "assessment_id": {"$ref": "#/$defs/id"}, "subject_root": {"$ref": "#/$defs/root"}, "lens_pack_root": {"$ref": "#/$defs/root"}, "pass_roots": {"$ref": "#/$defs/roots"}, "assessment_window": {"type": "integer", "minimum": 1}, "new_substantive_findings_by_pass": {"$ref": "#/$defs/counts"}, "accepted_substantive_changes_by_pass": {"$ref": "#/$defs/counts"}, "severity_weighted_yield_by_pass": {"$ref": "#/$defs/counts"}, "repeated_finding_count_by_pass": {"$ref": "#/$defs/counts"}, "regression_count_by_pass": {"$ref": "#/$defs/counts"}, "coverage_delta_basis_points": {"type": "object"}, "unresolved_high_severity_roots": {"$ref": "#/$defs/roots"}, "thresholds": {"type": "object"}, "result": {"enum": ["INSUFFICIENT_PASSES", "CONTINUE", "REVIEW_SATURATED_FOR_DECLARED_LENS_SET"]}, "stop_reason": {"type": "string", "minLength": 1}, "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "standing": {"const": "INFORMATION_ONLY"}, "authority_effect": {"const": "NONE"}, "real_a5": {"const": false}, "g0": {"const": "CLOSED"}, "saturation_assessment_root": {"$ref": "#/$defs/root"}},
  "$defs": {"root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "roots": {"type": "array", "items": {"$ref": "#/$defs/root"}, "uniqueItems": true}, "id": {"type": "string", "pattern": "^[A-Za-z0-9._:/@+-]+$", "maxLength": 192}, "counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}
}
