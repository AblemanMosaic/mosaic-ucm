{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mosaic.research.review-lens-pack.v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lens_pack_id", "subject_class", "lenses", "limitations", "standing", "authority_effect", "real_a5", "g0", "lens_pack_root"],
  "properties": {
    "schema": {"const": "mosaic.research.review-lens-pack.v0.1"},
    "lens_pack_id": {"$ref": "#/$defs/id"},
    "subject_class": {"$ref": "#/$defs/id"},
    "lenses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["lens_id", "title", "objective", "review_class", "required_context_roles", "deterministic_check_ids", "review_questions", "exclusions"], "properties": {
      "lens_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "review_class": {"$ref": "#/$defs/id"},
      "required_context_roles": {"$ref": "#/$defs/ids"}, "deterministic_check_ids": {"$ref": "#/$defs/ids"},
      "review_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exclusions": {"$ref": "#/$defs/texts"}
    }}},
    "limitations": {"$ref": "#/$defs/texts"}, "standing": {"const": "INFORMATION_ONLY"}, "authority_effect": {"const": "NONE"}, "real_a5": {"const": false}, "g0": {"const": "CLOSED"}, "lens_pack_root": {"$ref": "#/$defs/root"}
  },
  "$defs": {"root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9._:/@+-]+$", "maxLength": 192}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "texts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
