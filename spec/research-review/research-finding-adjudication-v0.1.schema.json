{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "mosaic.research.finding-adjudication.v0.1", "type": "object", "additionalProperties": false,
  "required": ["schema", "finding_root", "disposition", "reason_codes", "author_decision_root", "applied_change_root", "superseded_by_finding_root", "remaining_obligation_ids", "regression_review_required", "notes", "standing", "authority_effect", "real_a5", "g0", "adjudication_root"],
  "properties": {"schema": {"const": "mosaic.research.finding-adjudication.v0.1"}, "finding_root": {"$ref": "#/$defs/root"}, "disposition": {"enum": ["ACCEPTED", "REJECTED", "DEFERRED", "SUPERSEDED", "DUPLICATE"]}, "reason_codes": {"$ref": "#/$defs/ids"}, "author_decision_root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]}, "applied_change_root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]}, "superseded_by_finding_root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]}, "remaining_obligation_ids": {"$ref": "#/$defs/ids"}, "regression_review_required": {"type": "boolean"}, "notes": {"type": "string", "minLength": 1}, "standing": {"const": "INFORMATION_ONLY"}, "authority_effect": {"const": "NONE"}, "real_a5": {"const": false}, "g0": {"const": "CLOSED"}, "adjudication_root": {"$ref": "#/$defs/root"}},
  "$defs": {"root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9._:/@+-]+$", "maxLength": 192}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}}
}
